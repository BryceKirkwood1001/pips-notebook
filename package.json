{
  "name": "pips-notebook",
  "private": true,
  "type": "module",
  "description": "Pip's Notebook: teach Pip, then watch Pip fight. Phaser AE game (client/), API and ingest/RAG server (server/), shared contracts (shared/)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "tsx watch server/src/index.ts",
    "dev:game": "npm --prefix client run serve",
    "build:game": "npm --prefix client run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit",
    "e2e": "tsx scripts/e2e.ts",
    "ingest": "tsx server/src/ingest/cli.ts",
    "llm:smoke": "tsx server/src/llm/smoke.ts",
    "docs:api": "tsx scripts/generate-api-docs.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}

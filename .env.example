# Copy to .env (never commit .env). Everything has a default; with no keys the server runs fully on mocks.

# --- LLM (or use Settings > API setup in the game) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# gemini | openai | mock. Auto: Gemini key, then OpenAI key, otherwise mock.
# Saved UI settings in ignored .local/api-settings.json override these LLM settings.
LLM_PROVIDER=
# Gemini embedding model (OpenAI uses OPENAI_EMBEDDING_MODEL).
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
LLM_TIMEOUT_MS=30000
# Background course preparation calls can take longer than interactive turns.
INGEST_LLM_TIMEOUT_MS=180000

# --- Storage (MongoDB Atlas). Leave empty for persistent local .local/archive storage. ---
MONGODB_URI=
MONGODB_DB=pips_notebook
ATLAS_VECTOR_INDEX=chunks_vector

# --- Server ---
DEBUG=false
# The game and API share this port (npm start picks the next free one if it is busy).
PORT=8787
# Extra origins allowed to call the API. The game itself is same-origin; 4173 is its live dev preview.
CORS_ORIGINS=http://localhost:4173

# --- Ingest / RAG ---
CHUNK_TOKENS=400
CHUNK_OVERLAP=0.15
RETRIEVAL_TOP_K=6
MAX_UPLOAD_MB=25
MAX_PAGES=300
GEN_BATCH_SIZE=5
INGEST_CONCURRENCY=4

# --- Gameplay ---
MAX_STUDENT_QUESTIONS=3
ROOM_QUESTIONS=5
ROOM_HEARTS=3
ROOM_POOL_FACTOR=2
# Bookmarked (Option A). Not implemented; must stay false.
ROOM_DAMAGE_CARRIES_OVER=false
BOSS_QUESTIONS=10
BOSS_TARGETED_SHARE=0.5

# --- "Help me!" ---
HELP_ME_PROB=0.25
HELP_ME_MAX_PER_ROOM=1
HELP_ME_MAX_PER_BOSS=2
# false = untimed mode (no deadline), also the accessibility mode
HELP_ME_TIMED=true
HELP_ME_TIME_MULTIPLIER=1.0
HELP_ME_MIN_SEC=20
HELP_ME_MAX_SEC=240

GRADE_THRESHOLDS=A:93,A-:90,B+:87,B:83,B-:80,C+:77,C:73,C-:70,D:60

# When true: BOSS_QUESTIONS=6, ROOM_QUESTIONS=3, HELP_ME_TIME_MULTIPLIER=0.75
DEMO_MODE=false
